ply
format binary_little_endian 1.0
comment gaussian_factory_format graphdeco-gs-v1
comment sh_degree 1
comment sh_basis graphdeco_real_sh
comment sh_ordering degree_major_m_neg_to_pos
comment sh_channel_order rgb
comment f_rest_layout channel_major
comment quaternion_order wxyz
comment opacity_encoding logit
comment scale_encoding natural_log
comment color_space linear_srgb
element vertex 3
property float x
property float y
property float z
property float nx
property float ny
property float nz
property float f_dc_0
property float f_dc_1
property float f_dc_2
property float f_rest_0
property float f_rest_1
property float f_rest_2
property float f_rest_3
property float f_rest_4
property float f_rest_5
property float f_rest_6
property float f_rest_7
property float f_rest_8
property float opacity
property float scale_0
property float scale_1
property float scale_2
property float rot_0
property float rot_1
property float rot_2
property float rot_3
end_header
